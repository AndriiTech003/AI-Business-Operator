{
  "name": "@aio/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "node --enable-source-maps --watch dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@aio/agent-core": "workspace:*",
    "@aio/contracts": "workspace:*",
    "@aio/llm": "workspace:*",
    "@aio/policy": "workspace:*",
    "@aio/taint": "workspace:*",
    "@ashamrai/expr": "file:../../vendor/ashamrai-expr-0.1.0.tgz",
    "@fastify/cors": "^11.3.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "bullmq": "5.81.5",
    "cron-parser": "^5.10.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "yaml": "^2.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aio/bop-stack": "workspace:*",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "testcontainers": "^12.2.0",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
